generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  TENANT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role      @default(TENANT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedProperties     Property[]           @relation("OwnerProperties")
  rentedProperties     Property[]           @relation("TenantProperty")
  rentalRequests      RentalRequest[]      @relation("TenantRequests")
  initiatedTerminations TerminationRequest[] @relation("InitiatedTerminations")
  payments            Payment[]            @relation("TenantPayments")
  createdTickets      Ticket[]            @relation("CreatedTickets")
  ticketMessages      TicketMessage[]     @relation("AuthorMessages")
  createdTasks        Task[]              @relation("CreatedTasks")
  assignedTasks       Task[]              @relation("AssignedTasks")
  uploadedDocuments   Document[]          @relation("UploadedDocuments")

  @@map("users")
}

model Property {
  id          String   @id @default(cuid())
  title       String
  address     String
  description String?
  area        Decimal? @db.Decimal(6, 2)
  rooms       Int?
  floor       Int?
  rentPrice   Decimal  @db.Decimal(12, 2)
  status      PropertyStatus @default(AVAILABLE)
  rentStart   DateTime?
  rentEnd     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId  String
  owner    User   @relation("OwnerProperties", fields: [ownerId], references: [id])

  tenantId String?
  tenant   User?  @relation("TenantProperty", fields: [tenantId], references: [id])

  rentalRequests      RentalRequest[]      @relation("PropertyRequests")
  terminationRequests TerminationRequest[] @relation("PropertyTerminations")
  payments            Payment[]            @relation("PropertyPayments")
  expenses            Expense[]            @relation("PropertyExpenses")
  tickets             Ticket[]            @relation("PropertyTickets")
  tasks               Task[]              @relation("PropertyTasks")
  documents           Document[]          @relation("PropertyDocuments")

  @@index([ownerId])
  @@index([tenantId])
  @@map("properties")
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum ExpenseCategory {
  REPAIR
  UTILITIES
  MAINTENANCE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentType {
  CONTRACT
  ACT
  RECEIPT
  OTHER
}

model RentalRequest {
  id         String        @id @default(cuid())
  status     RequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenantId   String
  tenant     User          @relation("TenantRequests", fields: [tenantId], references: [id])
  propertyId String
  property   Property      @relation("PropertyRequests", fields: [propertyId], references: [id])

  @@unique([tenantId, propertyId])
  @@index([propertyId])
  @@index([tenantId])
  @@map("rental_requests")
}

model TerminationRequest {
  id         String        @id @default(cuid())
  status     RequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  initiatedById String
  initiatedBy   User   @relation("InitiatedTerminations", fields: [initiatedById], references: [id])
  propertyId    String
  property      Property @relation("PropertyTerminations", fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([initiatedById])
  @@map("termination_requests")
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  paidDate    DateTime?
  message     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  propertyId  String
  property    Property      @relation("PropertyPayments", fields: [propertyId], references: [id])
  tenantId    String
  tenant      User          @relation("TenantPayments", fields: [tenantId], references: [id])

  @@index([propertyId])
  @@index([tenantId])
  @@map("payments")
}

model Expense {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  description String
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  propertyId  String
  property    Property        @relation("PropertyExpenses", fields: [propertyId], references: [id])

  @@index([propertyId])
  @@map("expenses")
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdById String
  createdBy   User         @relation("CreatedTickets", fields: [createdById], references: [id])
  propertyId  String
  property    Property     @relation("PropertyTickets", fields: [propertyId], references: [id])

  messages    TicketMessage[] @relation("TicketMessages")

  @@index([propertyId])
  @@index([createdById])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(cuid())
  text        String
  createdAt   DateTime @default(now())

  ticketId    String
  ticket      Ticket   @relation("TicketMessages", fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("AuthorMessages", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdById String
  createdBy   User         @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo  User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  propertyId  String
  property    Property     @relation("PropertyTasks", fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@map("tasks")
}

model Document {
  id          String       @id @default(cuid())
  title       String
  type        DocumentType @default(OTHER)
  fileUrl     String
  fileName    String
  fileSize    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  uploadedById String
  uploadedBy   User         @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  propertyId   String
  property     Property     @relation("PropertyDocuments", fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([uploadedById])
  @@map("documents")
}
